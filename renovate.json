{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["patriksimms"],
  "timezone": "Europe/Berlin",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "recreateWhen": "always",
    "rebaseWhen": "conflicted",
    "branchTopic": "lock-file-maintenance",
    "commitMessageAction": "Lock file maintenance",
    "schedule": ["before 4pm on monday"],
    "prBodyDefinitions": {
      "Change": "All locks refreshed"
    }
  },
  "packageRules": [
    {
      "description": "Group React ecosystem packages into one PR",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React ecosystem"
    },
    {
      "description": "Group Vite and TypeScript tooling packages into one PR",
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "typescript"],
      "groupName": "Vite and TypeScript tooling"
    },
    {
      "description": "Group Tailwind ecosystem packages into one PR",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite", "@tailwindcss/typography"],
      "groupName": "Tailwind ecosystem"
    },
    {
      "description": "Upgrade all OpenTelemetry packages in one PR, majors included. Its 0.x and 1.x/2.x/3.x lines depend on each other, so split PRs fail on their own",
      "matchPackageNames": ["/^@opentelemetry\\//"],
      "groupName": "OpenTelemetry",
      "separateMajorMinor": false
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Require manual merging for minor and major updates",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
